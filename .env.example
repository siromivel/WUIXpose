# Copy to .env for local development. Real environment variables override this file.

# Django
DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG is false. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=
# Comma-separated. Defaults to localhost and 127.0.0.1 when DJANGO_DEBUG is true.
# DJANGO_ALLOWED_HOSTS=
# Where account emails (verification and password reset codes) go. Defaults to the console when
# DJANGO_DEBUG is true and to SMTP on localhost:25 otherwise. django-environ's format, e.g.
#   smtp+tls://user:password@smtp.example.com:587
# DJANGO_EMAIL_URL=consolemail://
# DJANGO_DEFAULT_FROM_EMAIL=WUIXpose <noreply@localhost>

# Postgres/PostGIS and Redis (defaults match compose.yaml)
# POSTGRES_DB=wuixpose
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# REDIS_URL=redis://localhost:6379/0

# GeoDjango native libraries. Only needed when Django can't find them on its own, e.g. on
# macOS with mise's Python and Homebrew's gdal and geos.
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# WUIXpose
# WUIXPOSE_TILE_CACHE_SECONDS=300
# WUIXPOSE_INGEST_USER_AGENT=WUIXpose ingest (+https://github.com/siromivel/wuixpose)

# Sign in with an OIDC provider (e.g. a Keycloak realm). Off unless the server URL is set; the
# client ID and secret are then required. The provider's redirect URI is
#   <site>/api/auth/oidc/<provider id>/login/callback/
# WUIXPOSE_OIDC_SERVER_URL=https://auth.example.org/realms/wuixpose
# WUIXPOSE_OIDC_CLIENT_ID=
# WUIXPOSE_OIDC_CLIENT_SECRET=
# WUIXPOSE_OIDC_PROVIDER_ID=keycloak
# WUIXPOSE_OIDC_PROVIDER_NAME=Keycloak
