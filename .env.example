# Copy to .env for local development. Real environment variables override this file.

# Django
DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG is false. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=
# Comma-separated. Defaults to localhost and 127.0.0.1 when DJANGO_DEBUG is true.
# DJANGO_ALLOWED_HOSTS=

# Postgres/PostGIS and Redis (defaults match compose.yaml)
# POSTGRES_DB=wuixpose
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# REDIS_URL=redis://localhost:6379/0

# WUIXpose
# WUIXPOSE_TILE_CACHE_SECONDS=300
# WUIXPOSE_INGEST_USER_AGENT=WUIXpose ingest (+https://github.com/siromivel/wuixpose)
