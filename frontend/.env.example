# Copy to .env.local to override. All optional; defaults are in src/config.ts.
# Values are baked in at build time, so set them before `npm run build`.

# VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
# VITE_IMAGERY_TILES=https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/{z}/{y}/{x}
# VITE_IMAGERY_ATTRIBUTION=Imagery: USGS
# VITE_DEFAULT_CENTER=-105.35,40.05

# Dev server only: where Vite proxies /api and /tiles.
# DJANGO_URL=http://localhost:8000
